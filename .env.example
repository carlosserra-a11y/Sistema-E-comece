# Copie para .env com:  npm run setup   (gera os segredos sozinho)
# NUNCA coloque o .env no Git. Só o .env.example vai para o repositório.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_PATH=data/armazem.db
APP_NAME=Carlos Desenvolvedor de Sistema

# Segredos (64 caracteres hexadecimais cada). `npm run setup` gera valores aleatórios.
PEPPER=
HMAC_KEY=
FIELD_KEY=

# Produção: origem pública exata (https). Em desenvolvimento pode ficar vazio.
PUBLIC_ORIGIN=
# true só se houver proxy reverso confiável na frente (usa X-Forwarded-For)
TRUST_PROXY=false   # na Vercel: true

# Usadas SOMENTE por `npm run criar-admin` (login de 11 dígitos e senha inicial).
# O script grava apenas o hash. Apague estas duas linhas depois de criar o admin.
ADMIN_LOGIN=
ADMIN_INITIAL_PASSWORD=

# Mercado Livre: minutos entre sincronizações de reconciliação (0 desliga). Credenciais do app ficam na tela Integrações (cifradas no banco), NUNCA aqui.
ML_POLL_MIN=10

# --- Produção (Supabase + Vercel) ---------------------------------------------------------------------------------------------
# Sem DATABASE_URL o sistema usa SQLite local (DB_PATH). Com ela, usa o PostgreSQL da Supabase.
# Use o endereço do POOLER (porta 6543, "Transaction pooler") com o papel app_wms — NUNCA o usuário "postgres".
# Formato: postgresql://app_wms.<ref-do-projeto>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Quantas conexões cada instância abre (em serverless, mantenha baixo).
DB_POOL_MAX=3
# Segredo do cron de manutenção da Vercel (a Vercel envia "Authorization: Bearer <CRON_SECRET>"). Gere um valor aleatório longo.
CRON_SECRET=
